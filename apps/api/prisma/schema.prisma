// StudyVerse data model (Phase 3). Authorization lives in the API (see README):
// Prisma connects with a privileged role, and RLS is enabled with no public policies.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlayerClass {
  warrior
  tank
  scholar
}

enum Difficulty {
  easy
  medium
  hard
}

enum TaskStatus {
  open
  completed
}

enum SessionStatus {
  created
  running
  paused
  finished
  claimed
  abandoned
}

enum SessionKind {
  study
  review
}

enum BattleMode {
  raid
  practice
}

enum BattleStatus {
  active
  victory
  defeat
  retreated
}

enum ItemSlot {
  weapon
  armor
}

enum Rarity {
  common
  uncommon
  rare
}

enum SkillBranch {
  might
  guard
  mind
}

enum ReviewContext {
  review
  battle
  session
}

enum QuestPeriod {
  daily
  weekly
}

enum ImportStatus {
  pending
  completed
  failed
}

model PlayerProfile {
  /// Supabase Auth user id (auth.users.id). Never generated here.
  id                String       @id @db.Uuid
  displayName       String       @db.VarChar(20)
  /// Lower-cased displayName; the unique key (Prisma cannot express lower() indexes).
  displayNameKey    String       @unique @db.VarChar(20)
  avatarKey         String?      @db.VarChar(64)
  avatarUrl         String?
  playerClass       PlayerClass?
  showOnLeaderboard Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  progress         PlayerProgress?
  xpTransactions   XpTransaction[]
  tasks            Task[]
  sessions         StudySession[]
  decks            FlashcardDeck[]
  flashcards       Flashcard[]
  flashcardReviews FlashcardReview[]
  items            PlayerItem[]
  equipment        Equipment?
  skills           PlayerSkill[]
  battles          Battle[]
  achievements     PlayerAchievement[]
  quests           PlayerQuest[]
  importBatches    ImportBatch[]
  questionReports  QuestionReport[]
}

model PlayerProgress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  level          Int       @default(1)
  totalXp        Int       @default(0)
  currentLevelXp Int       @default(0)
  streak         Int       @default(0)
  lastActiveDate DateTime? @db.Date
  studyEnergy    Int       @default(0)
  skillPoints    Int       @default(0)
  raidWins       Int       @default(0)
  raidLosses     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// The single ledger for every XP grant. unique(userId, sourceType, sourceId) makes grants idempotent.
model XpTransaction {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  amount              Int
  reason              String   @db.VarChar(120)
  sourceType          String   @db.VarChar(40)
  sourceId            String   @db.VarChar(120)
  leaderboardEligible Boolean  @default(true)
  /// Outcome recorded at grant time so a repeat call can return it unchanged.
  levelAfter          Int
  levelsGained        Int      @default(0)
  skillPointsAwarded  Int      @default(0)
  createdAt           DateTime @default(now())

  user PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId])
  @@index([leaderboardEligible, createdAt, userId])
  @@index([userId, createdAt])
  /// Daily caps sum a source group's amounts for one UTC day (grantXp `dailyCap`).
  @@index([userId, sourceType, createdAt])
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  title       String     @db.VarChar(200)
  difficulty  Difficulty @default(medium)
  subject     String     @default("Other") @db.VarChar(40)
  status      TaskStatus @default(open)
  completedAt DateTime?
  rewardedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model StudySession {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  title              String        @db.VarChar(120)
  subject            String        @db.VarChar(40)
  difficulty         Difficulty    @default(medium)
  plannedMinutes     Int
  status             SessionStatus @default(created)
  /// study = timed focus session; review = built from due flashcards (claim quiz uses those cards).
  kind               SessionKind   @default(study)
  /// Why a finished session paid nothing (e.g. "not_enough_time", "not_enough_focus", "stale").
  outcomeReason      String?       @db.VarChar(40)
  startedAt          DateTime?
  /// Set while paused; cleared on resume (its length is added to pausedTotalSec).
  pausedAt           DateTime?
  pausedTotalSec     Int           @default(0)
  finishedAt         DateTime?
  focusRatioReported Float?
  xpAwarded          Int           @default(0)
  energyAwarded      Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user           PlayerProfile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimQuestions SessionClaimQuestion[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model Question {
  id           String     @id @default(uuid()) @db.Uuid
  /// Id from data/questions.js (e.g. "math-e-001"). Null for non-builtin questions.
  legacyId     String?    @unique @db.VarChar(40)
  subject      String     @db.VarChar(40)
  difficulty   Difficulty
  text         String
  choices      String[]
  correctIndex Int
  explanation  String?
  needsReview  Boolean    @default(false)
  source       String     @default("builtin") @db.VarChar(20)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  claimQuestions SessionClaimQuestion[]
  battleTurns    BattleTurn[]
  reports        QuestionReport[]

  @@index([subject, difficulty])
}

/// One question of a session's claim quiz. The text/choices/answer are SNAPSHOTS taken when the quiz is
/// built (the quiz is stable across refreshes even if a flashcard is edited or deleted). correctIndex is
/// never sent to the browser before the quiz is submitted.
model SessionClaimQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @db.Uuid
  /// Set for question-bank questions.
  questionId    String?  @db.Uuid
  /// Set for review sessions built from flashcards (nulled if the card is later deleted).
  cardId        String?  @db.Uuid
  position      Int
  text          String
  choices       String[]
  correctIndex  Int
  presentedAt   DateTime @default(now())
  selectedIndex Int?
  correct       Boolean?

  session  StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question?    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  card     Flashcard?   @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([sessionId, position])
  @@index([questionId])
  @@index([cardId])
}

/// A player's "report this question" (wrong answer, bad wording, ...). One report per player per question.
model QuestionReport {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  userId     String   @db.Uuid
  reason     String?  @db.VarChar(300)
  createdAt  DateTime @default(now())

  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId])
}

model FlashcardDeck {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.VarChar(80)
  subject   String   @default("Other") @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Flashcard[]

  @@index([userId])
}

model Flashcard {
  id           String     @id @default(uuid()) @db.Uuid
  deckId       String     @db.Uuid
  /// Denormalized owner (must equal the deck owner; enforced in the service layer).
  userId       String     @db.Uuid
  question     String
  answer       String
  subject      String     @default("Other") @db.VarChar(40)
  difficulty   Difficulty @default(medium)
  distractors  String[]
  ease         Float      @default(2.5)
  intervalDays Int        @default(0)
  repetitions  Int        @default(0)
  dueAt        DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  deck           FlashcardDeck          @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user           PlayerProfile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews        FlashcardReview[]
  claimQuestions SessionClaimQuestion[]
  battleTurns    BattleTurn[]

  @@index([deckId])
  @@index([userId, dueAt])
}

model FlashcardReview {
  id            String        @id @default(uuid()) @db.Uuid
  cardId        String        @db.Uuid
  userId        String        @db.Uuid
  quality       Int
  correct       Boolean
  reviewedAt    DateTime      @default(now())
  intervalAfter Int
  easeAfter     Float
  context       ReviewContext @default(review)

  card Flashcard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId, reviewedAt])
}

model ItemDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(80)
  slot      ItemSlot
  rarity    Rarity
  atk       Int      @default(0)
  def       Int      @default(0)
  effectKey String?  @db.VarChar(60)
  spriteKey String   @db.VarChar(80)

  playerItems PlayerItem[]
}

model PlayerItem {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  itemDefinitionId String   @db.Uuid
  acquiredAt       DateTime @default(now())
  source           String   @db.VarChar(40)

  user           PlayerProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemDefinition ItemDefinition @relation(fields: [itemDefinitionId], references: [id], onDelete: Restrict)
  asWeaponIn     Equipment[]    @relation("EquipmentWeapon")
  asArmorIn      Equipment[]    @relation("EquipmentArmor")

  /// Lets Equipment point at (item, owner) so an equipped item must belong to the owner.
  @@unique([id, userId])
  @@index([userId])
  @@index([itemDefinitionId])
}

model Equipment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  weaponItemId String?  @db.Uuid
  armorItemId  String?  @db.Uuid
  updatedAt    DateTime @updatedAt

  user   PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// (weaponItemId, userId) -> PlayerItem(id, userId): an equipped item must belong to the owner.
  /// NoAction (not SetNull) because SetNull would also null the NOT NULL userId column.
  weapon PlayerItem?   @relation("EquipmentWeapon", fields: [weaponItemId, userId], references: [id, userId], onDelete: NoAction)
  armor  PlayerItem?   @relation("EquipmentArmor", fields: [armorItemId, userId], references: [id, userId], onDelete: NoAction)

  @@index([weaponItemId])
  @@index([armorItemId])
}

model SkillDefinition {
  id            String      @id @default(uuid()) @db.Uuid
  slug          String      @unique @db.VarChar(60)
  name          String      @db.VarChar(80)
  branch        SkillBranch
  cost          Int
  /// Slugs of skills that must be unlocked first.
  prerequisites String[]
  effectKey     String      @db.VarChar(60)

  playerSkills PlayerSkill[]
}

model PlayerSkill {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  skillId    String   @db.Uuid
  unlockedAt DateTime @default(now())

  user  PlayerProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([skillId])
}

model Battle {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  status           BattleStatus @default(active)
  mode             BattleMode
  subject          String       @db.VarChar(40)
  tier             Int          @default(1)
  enemySlug        String       @db.VarChar(60)
  enemyMaxHp       Int
  enemyHp          Int
  playerMaxHp      Int
  playerHp         Int
  turn             Int          @default(1)
  comboStreak      Int          @default(0)
  focus            Int          @default(0)
  seed             Int
  /// Engine bookkeeping that must survive a refresh (current intent, re-queued questions, once-per-battle flags).
  engineState      Json         @default("{}")
  /// Client Idempotency-Key for POST /battles; a double-click returns the same battle.
  idempotencyKey   String?      @db.VarChar(80)
  startedAt        DateTime     @default(now())
  endedAt          DateTime?
  rewardsGrantedAt DateTime?
  /// What `finish` paid, stored once so a repeat call returns the identical summary.
  rewardSummary    Json?

  user  PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns BattleTurn[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([userId, startedAt])
  /// Unlock rules are derived from raid victories per dungeon/boss (04 "unlock rules").
  @@index([userId, status, mode, enemySlug])
}

/// One turn: intent -> move -> question -> result. The row is created when the turn OPENS (intent known, no
/// question yet); the question is assigned when the player chooses a move, and is a SNAPSHOT (like claim
/// quizzes) so it is stable across refreshes. correctIndex / explanation are never sent before answering.
model BattleTurn {
  id                 String      @id @default(uuid()) @db.Uuid
  battleId           String      @db.Uuid
  turnNumber         Int
  intent             String      @db.VarChar(20)
  /// steady | brace | bold; null until chosen.
  move               String?     @db.VarChar(10)
  /// Set for bank questions (nulled never; Restrict) ...
  questionId         String?     @db.Uuid
  /// ... or for the player's own flashcards (nulled if the card is later deleted).
  cardId             String?     @db.Uuid
  questionDifficulty Difficulty?
  questionSubject    String?     @db.VarChar(40)
  questionText       String?
  choices            String[]
  correctIndex       Int?
  explanation        String?
  /// cleave | bulwark armed on this turn (Insight is recorded through removedIndex).
  armedAbility       String?     @db.VarChar(20)
  /// The wrong choice Insight removed (never the correct one).
  removedIndex       Int?
  selectedIndex      Int?
  correct            Boolean?
  damageDealt        Int         @default(0)
  damageTaken        Int         @default(0)
  /// The full resolved outcome, stored so a replayed answer returns exactly the same thing.
  result             Json?
  createdAt          DateTime    @default(now())
  answeredAt         DateTime?

  battle   Battle    @relation(fields: [battleId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Restrict)
  card     Flashcard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([battleId, turnNumber])
  @@index([questionId])
  @@index([cardId])
}

model Achievement {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique @db.VarChar(60)
  name        String  @db.VarChar(80)
  description String
  spriteKey   String? @db.VarChar(80)

  unlocks PlayerAchievement[]
}

model PlayerAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  unlockedAt    DateTime @default(now())

  user        PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement   @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementId])
  @@index([achievementId])
}

model QuestDefinition {
  id           String      @id @default(uuid()) @db.Uuid
  slug         String      @unique @db.VarChar(60)
  period       QuestPeriod
  title        String      @db.VarChar(120)
  description  String
  /// Event metric the quest counts (e.g. "sessions_finished", "cards_reviewed", "battles_won").
  metric       String      @db.VarChar(40)
  target       Int
  rewardXp     Int
  rewardEnergy Int         @default(0)

  playerQuests PlayerQuest[]
}

model PlayerQuest {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  questId   String    @db.Uuid
  /// Which day/week this instance belongs to, e.g. "2026-10-22" or "2026-W43" (UTC).
  periodKey String    @db.VarChar(20)
  progress  Int       @default(0)
  claimedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  PlayerProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest QuestDefinition @relation(fields: [questId], references: [id], onDelete: Restrict)

  @@unique([userId, questId, periodKey])
  @@index([questId])
}

model ImportBatch {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  payloadHash String       @db.VarChar(64)
  status      ImportStatus @default(pending)
  report      Json?
  createdAt   DateTime     @default(now())

  user PlayerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, payloadHash])
}
