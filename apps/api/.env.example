# API environment (apps/api/.env). Never commit the real file.
PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (CORS allowlist)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally; 1 on Render/Railway/Fly) so rate limits see real IPs
TRUST_PROXY=0

# --- Supabase (public values; used to verify access tokens) ---
SUPABASE_URL=https://uabltcqqqdsifwrwzcis.supabase.co
SUPABASE_JWKS_URL=https://uabltcqqqdsifwrwzcis.supabase.co/auth/v1/.well-known/jwks.json

# --- Database: copy from Supabase Dashboard > Connect (YOU must fill these in) ---
# Pooled connection (transaction pooler, port 6543) for the running API:
DATABASE_URL=postgresql://postgres.uabltcqqqdsifwrwzcis:[YOUR-DB-PASSWORD]@[POOLER-HOST]:6543/postgres
# Direct (or session-pooler, port 5432) connection used ONLY by `prisma migrate`:
DIRECT_URL=postgresql://postgres.uabltcqqqdsifwrwzcis:[YOUR-DB-PASSWORD]@[POOLER-HOST]:5432/postgres

# --- Rate limits (optional; defaults shown) ---
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_GENERAL_MAX=300
# RATE_LIMIT_AUTH_MAX=60
# RATE_LIMIT_BATTLE_ANSWER_MAX=60
# RATE_LIMIT_IMPORT_MAX=5

# NOTE: the Supabase secret / service_role key is NOT needed by this API and must not be put here.
# For database tests only (a database whose name contains "test"; it is wiped on every run):
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/studyverse_test
