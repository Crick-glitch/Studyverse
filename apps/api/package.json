{
  "name": "@studyverse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/require-db-env.mjs && prisma generate && prisma migrate dev",
    "db:deploy": "node scripts/require-db-env.mjs && prisma generate && prisma migrate deploy",
    "db:seed": "node scripts/require-db-env.mjs && prisma generate && tsx prisma/seed.ts",
    "db:studio": "node scripts/require-db-env.mjs && prisma generate && prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@studyverse/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0"
  }
}
