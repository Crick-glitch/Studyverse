# Only variables that Phase 1 actually reads. Later phases add Supabase/database vars.

# --- API (apps/api) ---
PORT=4000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API (CORS allowlist)
CORS_ORIGINS=http://localhost:5173

# --- Web (apps/web) ---
# Base URL of the API as seen from the browser
VITE_API_BASE_URL=http://localhost:4000/api/v1
